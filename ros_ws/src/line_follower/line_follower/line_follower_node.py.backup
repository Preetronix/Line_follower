
cat > src/line_follower/line_follower/line_follower_node.py <<'PY'
import rclpy
from rclpy.node import Node
from sensor_msgs.msg import Image
from geometry_msgs.msg import Twist
from cv_bridge import CvBridge
import cv2


class LineFollowerNode(Node):
    def __init__(self):
        super().__init__('line_follower_node')

        self.bridge = CvBridge()
        self.subscription = self.create_subscription(
            Image, '/line_follower/camera/image',
            self.camera_callback, 10
        )
        self.cmd_pub = self.create_publisher(Twist, '/cmd_vel', 10)

        self.base_speed = 0.08
        self.kp = 0.003
        self.max_angular = 0.4

        self.get_logger().info('Line follower started')

    def camera_callback(self, msg):
        frame = self.bridge.imgmsg_to_cv2(
            msg, desired_encoding='bgr8'
        )
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

        # Automatically choose a threshold for the current image.
        threshold, mask = cv2.threshold(
            gray, 0, 255, cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU
        )

        height, width = mask.shape

        # Examine more of the image to catch the dotted track.
        roi = mask[int(height * 0.35):, :]
        dark_pixels = cv2.countNonZero(roi)

        command = Twist()

        # Ignore frames with too few dark pixels to locate reliably.
        if dark_pixels >= 3:
            moments = cv2.moments(roi)

            if moments['m00'] > 0:
                center_x = moments['m10'] / moments['m00']
                error = center_x - width / 2

                command.linear.x = self.base_speed
                command.angular.z = max(
                    -self.max_angular,
                    min(self.max_angular, -self.kp * error)
                )

                self.get_logger().info(
                    f'Dark pixels: {dark_pixels}, '
                    f'threshold: {threshold:.0f}, error: {error:.1f}',
                    throttle_duration_sec=1.0
                )
            else:
                self.get_logger().warn(
                    'No track detected; stopping',
                    throttle_duration_sec=2.0
                )
        else:
            self.get_logger().warn(
                f'Too few dark pixels: {dark_pixels}; stopping',
                throttle_duration_sec=2.0
            )

        self.cmd_pub.publish(command)

    def destroy_node(self):
        self.cmd_pub.publish(Twist())
        super().destroy_node()


def main(args=None):
    rclpy.init(args=args)
    node = LineFollowerNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
PY