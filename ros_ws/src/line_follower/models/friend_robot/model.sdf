      </inertial>
      <collision name="wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.0325</radius>
            <length>0.022</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.4</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>10</kd>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="tire">
