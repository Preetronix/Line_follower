    </link>
    <link name="front_left_wheel">
      <pose>0.056 0.065 0.0325 1.5707963 0 0</pose>
      <inertial>
        <mass>0.075</mass>
        <inertia>
          <ixx>0.000045</ixx>
          <iyy>0.000045</iyy>
          <izz>0.000075</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
