            <size>0.012 0.040 0.055</size>
          </box>
        </geometry>
      </collision>
      <sensor name="line_following_camera" type="camera">
        <pose>0.025 0 0.035 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/line_follower/camera/image</topic>
        <camera>
          <horizontal_fov>1.20</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.03</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>
