        </geometry>
        <material>
          <ambient>0.05 0.05 0.06 1</ambient>
          <diffuse>0.08 0.08 0.09 1</diffuse>
        </material>
      </visual>
      </link>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_wheel</child>
      <pose relative_to="front_left_wheel">0 0 0 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>2.0</effort>
          <velocity>40</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
          <friction>0.01</friction>
        </dynamics>
