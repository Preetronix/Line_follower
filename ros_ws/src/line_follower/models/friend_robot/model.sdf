<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.9">
  <model name="pi_zero_four_wheel_line_follower">
    <!-- Wheel joints are anchored at their wheel-link origins; their axes are explicitly expressed in model coordinates. -->
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>
    <link name="chassis">
      <pose>0 0 0.040 0 0 0</pose>
      <inertial>
        <mass>0.42</mass>
        <inertia>
          <ixx>0.0011</ixx>
          <iyy>0.0018</iyy>
          <izz>0.0025</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="chassis_visual">
